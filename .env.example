# Copy this file to .env.local and fill it in from the Firebase console, then
# restart `npm run dev`.
#
# With .env.local absent or blank the app still runs perfectly well — your
# collection is just saved in one browser on one device, and the home page says
# so. Filling this in is what turns on syncing and the share link.
#
# .env.local is gitignored. These four values are not secrets in the usual
# sense: they ship inside any Firebase web app and identify the project rather
# than authorise anything. What protects the data is firestore.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Cover art for Blu-rays comes from TMDB, which is free and needs a read token.
# You already have one in movies-viz/picker.html — it's the long string on the
# `const TOKEN = '...'` line. Paste it here.
#
# Without it, films simply don't autofill their covers; the other four shelves
# are unaffected and nothing else breaks.
VITE_TMDB_TOKEN=

# The one Google account allowed to change anything, by its Firebase user id.
# Sign in once on your own copy and the home page prints it for you.
# Leave blank and the app stays read-only against a cloud project.
VITE_OWNER_UID=

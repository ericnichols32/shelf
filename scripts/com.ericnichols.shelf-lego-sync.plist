<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs scripts/sync-lego.mjs once a day at 9am.

  Installed into ~/Library/LaunchAgents by scripts/install-lego-sync.sh. If the
  Mac is asleep at 9, launchd runs it on waking; if it is switched off, that
  day is simply skipped and tomorrow's run catches up — the sync always
  compares the whole list, so nothing is lost by a missed day.

  Output goes to ~/Library/Logs/shelf-lego-sync.log.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ericnichols.shelf-lego-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "$HOME/Code/shelf" &amp;&amp; SHELF_SERVICE_ACCOUNT="$HOME/.config/shelf/service-account.json" node scripts/sync-lego.mjs</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/ericnichols/Library/Logs/shelf-lego-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ericnichols/Library/Logs/shelf-lego-sync.log</string>
</dict>
</plist>
